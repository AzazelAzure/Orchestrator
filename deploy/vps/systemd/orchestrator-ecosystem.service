[Unit]
Description=Orchestrator VPS shared mutation plane (redis, coordinator, workers, scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/orchestrator
Environment=COMPOSE=podman-compose
ExecStart=/bin/bash -lc 'podman-compose -f docker-compose.yml -f deploy/vps/docker-compose.vps.yml --env-file .env.vps up -d redis coordinator worker scheduler script-spool-init script-runner script-worker'
ExecStop=/bin/bash -lc 'podman-compose -f docker-compose.yml -f deploy/vps/docker-compose.vps.yml --env-file .env.vps stop redis coordinator worker scheduler script-spool-init script-runner script-worker'
TimeoutStartSec=900

[Install]
WantedBy=default.target
