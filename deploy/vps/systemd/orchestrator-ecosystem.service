[Unit]
Description=Orchestrator VPS ecosystem stack (api, worker, ops-console)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/orchestrator
Environment=COMPOSE=podman-compose
ExecStart=/bin/bash -lc 'podman-compose -f docker-compose.yml -f deploy/vps/docker-compose.vps.yml --env-file .env.vps up -d redis coordinator api worker scheduler script-spool-init script-runner script-worker ops-console'
ExecStop=/bin/bash -lc 'podman-compose -f docker-compose.yml -f deploy/vps/docker-compose.vps.yml --env-file .env.vps stop'
TimeoutStartSec=900

[Install]
WantedBy=default.target
