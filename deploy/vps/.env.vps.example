# VPS environment template — copy to .env.vps on the VPS (never commit secrets).
# Install path suggestion: ~/orchestrator/

# Optional loopback-only diagnostics for presentation ports (127.0.0.1:8000/8010/8081/8091).
# Omit on VPS — edge routing uses per-color Podman networks, not host publications.
# ORCH_DIAG_BIND=127.0.0.1

# Optional installation hook before edge-proxy nginx validation/reload (e.g. attach proxy to
# per-color presentation networks). Portable Orchestrator skips when unset.
# ORCH_EDGE_PROXY_PRE_RELOAD_CMD=bash /path/to/installation/edge-proxy-pre-reload.sh attach
# ORCH_EDGE_PROXY_PRE_RELOAD_REQUIRED=1

REDIS_PASSWORD=change-me-redis-password
DJANGO_SECRET_KEY=change-me-django-secret-key
DJANGO_ALLOWED_HOSTS=api.thedirectorate.app,127.0.0.1,localhost,www.thedirectorate.app,orch-api-blue,orch-api-green,api-blue,api-green,orch-console-blue,orch-console-green
CORS_ALLOWED_ORIGINS=https://www.thedirectorate.app
CSRF_TRUSTED_ORIGINS=https://www.thedirectorate.app,https://api.thedirectorate.app
COORDINATOR_URL=http://coordinator:9001
ORCH_SCRIPT_IMAGE_DIGEST=replace-after-build-script-runner-attestation
FOUNDER_API_TOKEN=replace-with-founder-token

# Ops console build-time API base (baked into static assets at image build)
VITE_API_BASE_URL=https://api.thedirectorate.app
