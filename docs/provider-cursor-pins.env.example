# Installation-local Cursor provider pins (no secrets).
# Copy to .local/provider/cursor.pins.env and set exact model IDs from:
#   cursor-agent models   (requires CURSOR_API_KEY in host process)
#
# ORCH_PROVIDER_MODEL and ORCH_PROVIDER_ALLOWED_MODELS must use exact IDs
# returned by the CLI — not aliases such as "auto".
#
# HitM confirmed 2026-07-28: composer-2.5 (changeable later).

ORCH_PROVIDER_MODEL=composer-2.5
ORCH_PROVIDER_ALLOWED_MODELS=composer-2.5
