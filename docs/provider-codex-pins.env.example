# Installation-local Codex provider pins (no secrets).
# Copy to .local/provider/codex.pins.env.
#
# ORCH_PROVIDER_MODEL and ORCH_PROVIDER_ALLOWED_MODELS must use exact IDs
# returned by the Codex CLI — not aliases such as "auto" or "opus".
#
# HitM confirmed 2026-08-01: gpt-5.6-sol (changeable later).
# Auth remains Codex subscription login on the host CLI.

ORCH_PROVIDER_MODEL=gpt-5.6-sol
ORCH_PROVIDER_ALLOWED_MODELS=gpt-5.6-sol
