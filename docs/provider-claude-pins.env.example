# Installation-local Claude provider pins (no secrets).
# Copy to .local/provider/claude.pins.env.
#
# Use an exact model ID for ORCH_PROVIDER_MODEL / ORCH_PROVIDER_ALLOWED_MODELS.
# Interactive Claude Code may use alias "opus"; the host-runner pin must be exact.
#
# HitM confirmed 2026-07-28: claude-opus-4-8 (Opus family; changeable later).
# Auth remains Claude subscription login on the host CLI (no ANTHROPIC_API_KEY required).

ORCH_PROVIDER_MODEL=claude-opus-4-8
ORCH_PROVIDER_ALLOWED_MODELS=claude-opus-4-8
